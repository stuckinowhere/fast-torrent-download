<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FastTorrentDownload.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#ECECEA" />
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#E3E3E0" />
          <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#101010" />
          <SolidColorBrush x:Key="HeaderMutedBrush" Color="#505050" />
          <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#101010" />
          <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#C62828" />
          <!-- The identity is monochrome: ink carries progress and selection; hue is reserved for state. -->
          <SolidColorBrush x:Key="InkBrush" Color="#101010" />
          <SolidColorBrush x:Key="MutedInkBrush" Color="#5A5A58" />
          <SolidColorBrush x:Key="TrackBrush" Color="#D2D2CE" />
          <SolidColorBrush x:Key="RowBorderBrush" Color="#B4B4B0" />
          <SolidColorBrush x:Key="StateRunningBrush" Color="#17663A" />
          <SolidColorBrush x:Key="StateWarningBrush" Color="#8A5300" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101010" />
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="HeaderMutedBrush" Color="#D0D0D0" />
          <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#EF9A9A" />
          <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MutedInkBrush" Color="#A8A8A4" />
          <SolidColorBrush x:Key="TrackBrush" Color="#3A3A38" />
          <SolidColorBrush x:Key="RowBorderBrush" Color="#4A4A48" />
          <!-- With a white accent the stock white tick would vanish; draw it in the dark ink instead. -->
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#101010" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#101010" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#101010" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" Color="#101010" />
          <SolidColorBrush x:Key="StateRunningBrush" Color="#7BD99B" />
          <SolidColorBrush x:Key="StateWarningBrush" Color="#F2B84B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Ink replaces the system accent everywhere Fluent uses it: check boxes, focus, selection. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#101010" />
        <ColorPaletteResources x:Key="Dark" Accent="#FFFFFF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI Variable" />
      <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,0" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <!-- Destructive confirmation: the one place a button carries the error hue. -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource ErrorForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource WindowBackgroundBrush}" />
    </Style>
    <Style Selector="Button.header-button">
      <Setter Property="Foreground" Value="{DynamicResource HeaderForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HeaderForegroundBrush}" />
    </Style>
    <Style Selector="Button.primary.header-button">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.row-action">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- Secondary row actions recede so Resume/Pause reads first. -->
    <Style Selector="Button.row-action.quiet">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Button.row-action.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource RowBorderBrush}" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ProgressBar.stalled">
      <Setter Property="Foreground" Value="{DynamicResource StateWarningBrush}" />
    </Style>
    <Style Selector="ProgressBar.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
    </Style>
    <Style Selector="Border.state-chip">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource RowBorderBrush}" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedInkBrush}" />
    </Style>
    <Style Selector="Border.state-chip.running">
      <Setter Property="BorderBrush" Value="{DynamicResource StateRunningBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource StateRunningBrush}" />
    </Style>
    <Style Selector="Border.state-chip.stalled">
      <Setter Property="BorderBrush" Value="{DynamicResource StateWarningBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource StateWarningBrush}" />
    </Style>
    <Style Selector="Border.state-chip.error">
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
    </Style>
    <Style Selector="Border.torrent-row">
      <Setter Property="BorderBrush" Value="{DynamicResource RowBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,14" />
    </Style>
    <!-- Selection is an ink outline, not a tinted fill: text contrast stays the same in both themes. -->
    <Style Selector="ListBoxItem:selected Border.torrent-row">
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.dialog-footer">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Application.Styles>
</Application>
