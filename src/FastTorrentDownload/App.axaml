<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FastTorrentDownload.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#ECECEA" />
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#E3E3E0" />
          <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#101010" />
          <SolidColorBrush x:Key="HeaderMutedBrush" Color="#505050" />
          <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#101010" />
          <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101010" />
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="HeaderMutedBrush" Color="#D0D0D0" />
          <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI Variable" />
      <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,0" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.outline">
      <Setter Property="BorderBrush" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
  </Application.Styles>
</Application>
