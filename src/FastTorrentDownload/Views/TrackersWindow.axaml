<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FastTorrentDownload.Views.TrackersWindow"
        Title="Trackers" ShowInTaskbar="False" Width="640" Height="520" MinWidth="480" MinHeight="400" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" RowSpacing="10">
    <TextBlock Text="Trackers" FontSize="20" FontWeight="Bold" />
    <TextBlock x:Name="NameTextBlock" Grid.Row="1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <SelectableTextBlock x:Name="CurrentTextBlock" TextWrapping="Wrap" LineHeight="20" />
    </ScrollViewer>
    <TextBlock Grid.Row="3" Text="Add trackers" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBox x:Name="NewTrackersTextBox" Grid.Row="4" AcceptsReturn="True" Height="96" TextWrapping="NoWrap"
             PlaceholderText="udp://tracker.example.org:1337/announce — one per line" />
    <TextBlock Grid.Row="5" TextWrapping="Wrap" Foreground="{DynamicResource MutedInkBrush}"
               Text="Each tracker you add learns this torrent's info-hash and your IP address. Added trackers are announced to right away and kept after a restart." />
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
      <Button Classes="dialog-footer" Content="Close" Click="Cancel_Click" IsCancel="True" />
      <Button Classes="primary dialog-footer" Content="Add trackers" Click="Add_Click" />
    </StackPanel>
  </Grid>
</Window>
