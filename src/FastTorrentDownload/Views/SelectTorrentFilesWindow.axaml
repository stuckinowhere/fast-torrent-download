<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FastTorrentDownload.Views"
        x:Class="FastTorrentDownload.Views.SelectTorrentFilesWindow"
        x:DataType="local:SelectTorrentFilesWindow"
        Title="Select torrent files" Width="760" Height="560"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
    <StackPanel Spacing="4">
      <TextBlock Text="Select files to download" FontSize="20" FontWeight="Bold" />
      <TextBlock Text="Choose the files to keep. Unselected files will not be downloaded." Opacity="0.72" />
      <TextBlock Text="{Binding TorrentName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <ListBox Grid.Row="1" ItemsSource="{Binding Files}"
             BorderThickness="1" Padding="8" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:TorrentFileSelectionItem">
          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    HorizontalContentAlignment="Stretch" Padding="8,7">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" FontFamily="Consolas" Opacity="0.72" />
            </Grid>
          </CheckBox>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="2" x:Name="StatusTextBlock" Foreground="#C62828"
               TextWrapping="Wrap" IsVisible="False" />

    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
      <Button Content="Select all" Click="SelectAll_Click" />
      <Button Grid.Column="1" Content="Select none" Click="SelectNone_Click" />
      <Button Grid.Column="3" Classes="primary" Content="Add selected files" Click="Add_Click" />
    </Grid>
  </Grid>
</Window>
