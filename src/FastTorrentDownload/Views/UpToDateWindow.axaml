<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FastTorrentDownload.Views.UpToDateWindow"
        x:CompileBindings="False"
        Title="Up to date" ShowInTaskbar="False" Width="450" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="You're on the latest version" FontSize="20" FontWeight="Bold" />
    <TextBlock x:Name="DescriptionTextBlock" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
      <Button Classes="primary dialog-footer" Content="OK" Click="Ok_Click" MinWidth="160" />
    </StackPanel>
  </StackPanel>
</Window>
