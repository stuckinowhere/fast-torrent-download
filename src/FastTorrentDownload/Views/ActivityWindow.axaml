<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FastTorrentDownload.Views"
        xmlns:models="using:FastTorrentDownload.Models"
        x:Class="FastTorrentDownload.Views.ActivityWindow"
        x:DataType="local:ActivityWindow"
        Title="Activity" Width="720" Height="440" MinWidth="500" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <TextBlock Text="This session · latest 50 messages" FontWeight="Bold" FontSize="18" />
    <ListBox Grid.Row="1" ItemsSource="{Binding Activity}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:ActivityEntry">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Open folder" IsVisible="{Binding CanOpenFolder}" Tag="{Binding Destination}" Click="OpenFolder_Click" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Button Grid.Row="2" Content="Close" Click="Close_Click" HorizontalAlignment="Right" />
  </Grid>
</Window>
