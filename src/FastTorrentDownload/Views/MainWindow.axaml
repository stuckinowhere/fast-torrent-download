<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FastTorrentDownload.ViewModels"
        x:Class="FastTorrentDownload.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="fast torrent download"
        Width="1180" Height="760"
        MinWidth="880" MinHeight="600"
        ShowInTaskbar="True"
        DragDrop.AllowDrop="True" DragDrop.Drop="Drop_Handle"
        Background="{DynamicResource WindowBackgroundBrush}">

  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">
    <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="28,20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Border Width="42" Height="42" Background="{DynamicResource HeaderForegroundBrush}"
                  VerticalAlignment="Center">
            <Path Data="M12,4 V17 M6.5,11.5 L12,17 L17.5,11.5 M5,21 H19" Width="24" Height="24" Stretch="None"
                  HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="2.6"
                  Stroke="{DynamicResource HeaderBackgroundBrush}" />
          </Border>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="fast torrent download" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource HeaderForegroundBrush}" />
            <TextBlock Text="A local-first Windows BitTorrent client" Opacity="0.9"
                       Foreground="{DynamicResource HeaderMutedBrush}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="header-button" Click="ThemeToggle_Click" ToolTip.Tip="Toggle dark/light theme"
                  AutomationProperties.Name="Toggle dark or light theme">
            <Path Data="M20,13.2 A8.2,8.2 0 1 1 10.8,4 A6.4,6.4 0 0 0 20,13.2 Z" Width="18" Height="18" Stretch="Uniform"
                  StrokeThickness="1.8" StrokeJoin="Round"
                  Stroke="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="header-button" Content="Check update" Click="Update_Click" />
          <Button Classes="header-button" Content="Settings" Click="Settings_Click" />
          <Button Classes="primary header-button" Content="+ Add torrent" Click="Add_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="QueuePageGrid" Grid.Row="1" RowDefinitions="Auto,*" Margin="28,22,28,14" IsVisible="{Binding IsQueueOpen}">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal" Spacing="18">
          <TextBlock Text="{Binding QueueSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TotalDownloadRate}" FontFamily="Consolas" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TotalUploadRate}" FontFamily="Consolas" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Content="Default folder" Click="Folder_Click" ToolTip.Tip="Open the default download folder" />
      </Grid>

      <ListBox Grid.Row="1" ItemsSource="{Binding Torrents}" SelectedItem="{Binding SelectedTorrent, Mode=TwoWay}"
               BorderThickness="0" Background="Transparent" IsVisible="{Binding HasTorrents}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TorrentRowViewModel">
            <Border Classes="torrent-row">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="16">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip.Tip="{Binding Name}" />
                <Border Grid.Column="1" Classes="state-chip" Classes.running="{Binding IsRunningState}"
                        Classes.stalled="{Binding IsStalledState}" Classes.error="{Binding IsErrorState}">
                  <TextBlock Text="{Binding StateDisplay}" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6"
                             Classes.stalled="{Binding IsStalledState}" Classes.error="{Binding IsErrorState}" />
                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <TextBlock Text="{Binding ProgressLabel}" FontFamily="Consolas" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding DetailLabel}" Foreground="{DynamicResource MutedInkBrush}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DetailLabel}" />
                  <TextBlock Grid.Column="2" Text="{Binding TransferLabel}" FontFamily="Consolas" IsVisible="{Binding IsRunningState}" />
                </Grid>
                <!-- Actions live on the row they act on (Fitts): no selection step, no chooser dialog. -->
                <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="6">
                    <Button Classes="row-action" Content="Resume" Click="RowResume_Click" IsVisible="{Binding CanResume}" IsEnabled="{Binding CanAct}" Margin="0,0,6,0" />
                    <Button Classes="row-action" Content="Pause" Click="RowPause_Click" IsVisible="{Binding CanPause}" IsEnabled="{Binding CanAct}" Margin="0,0,6,0" />
                    <Button Classes="row-action quiet" Content="Recheck" Click="RowRecheck_Click" IsEnabled="{Binding CanAct}" />
                    <Button Classes="row-action quiet" Content="Files…" Click="RowFiles_Click" IsEnabled="{Binding CanAct}" />
                    <Button Classes="row-action quiet" Content="Move…" Click="RowMove_Click" IsEnabled="{Binding CanAct}" />
                    <Button Classes="row-action quiet" Content="Trackers…" Click="RowTrackers_Click" IsEnabled="{Binding CanAct}" />
                    <Button Classes="row-action quiet" Content="Show folder" Click="RowFolder_Click" />
                    <Button Classes="row-action quiet" Content="Remove" Click="RowRemove_Click" IsEnabled="{Binding CanAct}"
                            ToolTip.Tip="Remove from the queue and keep the downloaded files" />
                    <Button Classes="row-action quiet" Content="Delete files…" Click="RowDelete_Click" IsEnabled="{Binding CanAct}"
                            ToolTip.Tip="Remove from the queue and delete the downloaded files" />
                  </WrapPanel>
                  <Button Grid.Column="1" Classes="row-action quiet" Content="{Binding DetailsToggleLabel}" Click="RowDetails_Click" VerticalAlignment="Top" />
                </Grid>
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="6" Margin="0,4,0,2" IsVisible="{Binding IsDetailsOpen}">
                  <SelectableTextBlock Text="{Binding Destination}" TextWrapping="Wrap" />
                  <SelectableTextBlock Text="{Binding SessionLabel}" TextWrapping="Wrap" Foreground="{DynamicResource MutedInkBrush}" />
                  <SelectableTextBlock Text="{Binding DiagnosticsText}" TextWrapping="Wrap" LineHeight="20" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Empty queue: teach the three ways in instead of showing a blank page. -->
      <StackPanel Grid.Row="1" IsVisible="{Binding !HasTorrents}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="520">
        <TextBlock Text="No torrents yet" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedInkBrush}" LineHeight="22"
                   Text="Drop a .torrent file on this window, press Ctrl+V with a magnet link copied, or use “+ Add torrent”. You choose which files to download before anything starts." />
      </StackPanel>
    </Grid>

    <Grid x:Name="SettingsPageGrid" Grid.Row="1" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12" Margin="28,22,28,14" IsVisible="{Binding IsSettingsOpen}">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
        <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="← Back to torrents" Click="CancelSettings_Click" />
      </Grid>

      <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="22">
          <StackPanel Spacing="7">
            <TextBlock Text="Downloads" FontWeight="Bold" FontSize="18" />
            <TextBlock Text="Default download folder" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="DefaultDownloadFolderTextBox" />
              <Button Grid.Column="1" Content="Choose…" Click="ChooseFolder_Click" MinHeight="44" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
            </Grid>
            <TextBlock Text="Files remain on disk when you remove an item from the queue." Opacity="0.68" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,8,0,0">
              <TextBlock Text="Maximum active downloads (0 = unlimited)" VerticalAlignment="Center" />
              <TextBox x:Name="MaxActiveTextBox" Grid.Column="1" Width="150" HorizontalAlignment="Left" />
            </Grid>
            <TextBlock Text="Torrents beyond the limit wait as “Queued” and start automatically when a slot frees up." Opacity="0.68" TextWrapping="Wrap" />
            <CheckBox x:Name="SequentialDefaultCheckBox" Content="Download new torrents in order by default" Margin="0,8,0,0" />
            <TextBlock Text="Each torrent can be changed from its Files… dialog. In-order downloads let you open media early; the default, rarest-first, is healthier for the swarm." Opacity="0.68" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="7">
            <TextBlock Text="Network" FontWeight="Bold" FontSize="18" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
              <TextBlock Text="Listen port" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBox x:Name="ListenPortTextBox" Width="130" HorizontalAlignment="Left" />
                <Button Content="Port forwarding guide…" Click="PortGuide_Click" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="Listener IPv4 address" VerticalAlignment="Center" />
              <TextBox x:Name="ListenAddressTextBox" Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left" />
              <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                <CheckBox x:Name="DhtCheckBox" Content="DHT" Margin="0,0,18,8" />
                <CheckBox x:Name="PexCheckBox" Content="Peer exchange" Margin="0,0,18,8" />
                <CheckBox x:Name="LsdCheckBox" Content="Local peer discovery" Margin="0,0,18,8" />
                <CheckBox x:Name="PortForwardingCheckBox" Content="UPnP / NAT-PMP port forwarding" Margin="0,0,18,8" />
                <CheckBox x:Name="IPv6CheckBox" Content="IPv6 peers" Margin="0,0,18,8"
                          ToolTip.Tip="Also accept and connect to peers over IPv6. Applies when the listener address is 0.0.0.0." />
                <CheckBox x:Name="EncryptionCheckBox" Content="Require encrypted peer connections" Margin="0,0,18,8" />
              </WrapPanel>
            </Grid>
            <TextBlock Text="Listener binding controls incoming connections only; it is not a VPN kill switch or a complete outbound leak-prevention control." Opacity="0.68" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="7">
            <TextBlock Text="Privacy" FontWeight="Bold" FontSize="18" />
            <CheckBox x:Name="PublicCachesCheckBox" Content="Fetch magnet file lists from public .torrent caches" />
            <TextBlock Text="Off by default. When on, the info-hash of each magnet link you add is sent to itorrents.org, torrage.info and btcache.me to resolve the file list faster. The swarm (DHT / trackers) is always used as well." Opacity="0.68" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="7">
            <TextBlock Text="Bandwidth and completion" FontWeight="Bold" FontSize="18" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
              <TextBlock Text="Download limit (KiB/s, 0 = unlimited)" VerticalAlignment="Center" />
              <TextBox x:Name="DownloadLimitTextBox" Grid.Column="1" Width="150" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="1" Text="Upload limit (KiB/s, 0 = unlimited)" VerticalAlignment="Center" />
              <TextBox x:Name="UploadLimitTextBox" Grid.Row="1" Grid.Column="1" Width="150" HorizontalAlignment="Left" />
            </Grid>
            <TextBlock Text="Completed downloads leave the queue automatically. Downloaded files are kept, and the completion notification lets you open their folder." Opacity="0.68" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="7">
            <TextBlock Text="Behaviour" FontWeight="Bold" FontSize="18" />
            <WrapPanel>
              <CheckBox x:Name="CloseToTrayCheckBox" Content="Closing the window keeps downloads running in the tray" Margin="0,0,18,8" />
              <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows (minimized to tray)" Margin="0,0,18,8" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="7">
            <TextBlock Text="Appearance" FontWeight="Bold" FontSize="18" />
            <ComboBox x:Name="ThemeComboBox" Width="160" HorizontalAlignment="Left" SelectedIndex="0">
              <ComboBoxItem Content="System" />
              <ComboBoxItem Content="Light" />
              <ComboBoxItem Content="Dark" />
            </ComboBox>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <TextBlock Grid.Row="2" x:Name="ValidationErrorTextBlock"
                 Foreground="{DynamicResource ErrorForegroundBrush}"
                 TextWrapping="Wrap" IsVisible="False" />

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
        <Button Classes="dialog-footer" Content="Cancel" Click="CancelSettings_Click" />
        <Button Classes="primary dialog-footer" Content="Save settings" Click="SaveSettings_Click" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" IsVisible="{Binding HasPortWarning}" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="0,1,0,0" Padding="28,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding PortWarningMessage}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="primary" Content="How to open port" Click="PortGuide_Click" />
          <Button Content="Dismiss" Click="DismissPortWarning_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="3" IsVisible="{Binding HasNotification}" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="0,1,0,0" Padding="28,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding Notification.Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Open folder" Click="NotificationFolder_Click" IsVisible="{Binding CanOpenNotificationFolder}" />
      </Grid>
    </Border>

    <Border Grid.Row="4" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="0,1,0,0" Padding="28,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}" Opacity="0.8" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Activity" Click="Activity_Click" />
      </Grid>
    </Border>

    <Border Grid.Row="5" Padding="28,2,28,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="© 2026 stuckinowhere" HorizontalAlignment="Left" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding AppVersionLabel}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
