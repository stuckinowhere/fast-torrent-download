<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FastTorrentDownload.Views.UpdateAvailableWindow"
        Title="Update available" Width="450" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="A new version is ready" FontSize="20" FontWeight="Bold" />
    <TextBlock x:Name="DescriptionTextBlock" TextWrapping="Wrap" />
    <TextBlock Text="Opening the release page lets you review the notes and checksum before downloading." TextWrapping="Wrap" Opacity="0.7" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Later" Click="Later_Click" />
      <Button Classes="primary" Content="Open release page" Click="Open_Click" />
    </StackPanel>
  </StackPanel>
</Window>
