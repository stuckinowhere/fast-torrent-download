<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FastTorrentDownload.Views"
        x:Class="FastTorrentDownload.Views.AddTorrentWindow"
        x:DataType="local:AddTorrentWindow"
        Title="Add torrent" Width="650" SizeToContent="Height" ShowInTaskbar="False"
        CanResize="False" WindowStartupLocation="CenterOwner" DragDrop.AllowDrop="True" DragDrop.Drop="Drop_Handle">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
    <StackPanel Spacing="7">
      <TextBlock Text="Magnet link or .torrent file" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox x:Name="SourceTextBox" PlaceholderText="magnet:?xt=urn:btih:…" />
        <Button Grid.Column="1" Content="Browse…" Click="BrowseTorrent_Click" MinHeight="44" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
      </Grid>
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="7">
      <TextBlock Text="Download folder" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox x:Name="DestinationTextBox" />
        <Button Grid.Column="1" Content="Choose…" Click="ChooseFolder_Click" MinHeight="44" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
      </Grid>
    </StackPanel>
    <CheckBox Grid.Row="2" x:Name="StartImmediatelyCheckBox" IsChecked="True" Content="Start immediately" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
      <Button Classes="dialog-footer" Content="Cancel" Click="Cancel_Click" />
      <Button Classes="primary dialog-footer" Content="Add torrent" Click="Add_Click" />
    </StackPanel>
  </Grid>
</Window>
