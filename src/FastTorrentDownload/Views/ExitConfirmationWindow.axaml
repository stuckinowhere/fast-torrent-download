<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FastTorrentDownload.Views.ExitConfirmationWindow"
        Title="Exit safely?" Width="430" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="Exit fast torrent download?" FontSize="20" FontWeight="Bold" />
    <TextBlock Text="Active torrents will stop and the queue will be saved for your next launch." TextWrapping="Wrap" />
    <CheckBox x:Name="RememberCheckBox" Content="Don't ask again" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Keep running" Click="Cancel_Click" Height="36" MinHeight="0" Padding="14,0"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button Classes="primary" Content="Exit safely" Click="Exit_Click" Height="36" MinHeight="0" Padding="14,0"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</Window>
