<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FastTorrentDownload.Views"
        x:Class="FastTorrentDownload.Views.ExitConfirmationWindow"
        x:DataType="local:ExitConfirmationWindow"
        Title="Exit safely?" ShowInTaskbar="False" Width="430" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="Exit fast torrent download?" FontSize="20" FontWeight="Bold" />
    <TextBlock Text="Active torrents will stop and the queue will be saved for your next launch." TextWrapping="Wrap" />
    <CheckBox x:Name="RememberCheckBox" Content="Don't ask again" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
      <Button Classes="dialog-footer" Content="Keep running" Click="Cancel_Click" />
      <Button Classes="primary dialog-footer" Content="Exit safely" Click="Exit_Click" />
    </StackPanel>
  </StackPanel>
</Window>
